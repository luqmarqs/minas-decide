# Security headers for the static SPA (Cloudflare Workers Static Assets `_headers`).
# /api/* headers are set by the Worker itself. Review the CSP allowlist whenever a
# new external origin (tiles, fonts, auth) is introduced. HSTS only on real HTTPS domains.
# Clerk (ADR 0005): only the dev instance Frontend API host (from the publishable key); no wildcards (QA3-08).
# Production (instance live) needs its own clerk.<domain> host here once a domain exists.
# The browser no longer talks to Supabase (Worker only), so *.supabase.co was removed.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://funky-cheetah-9841.clerk.accounts.dev; frame-src https://challenges.cloudflare.com https://funky-cheetah-9841.clerk.accounts.dev; connect-src 'self' https://tiles.openfreemap.org https://challenges.cloudflare.com https://funky-cheetah-9841.clerk.accounts.dev; img-src 'self' data: blob: https://tiles.openfreemap.org https://img.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/geo/*
  Cache-Control: public, max-age=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800
