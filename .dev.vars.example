# Copy to .dev.vars (gitignored). Local Worker secrets. TARGET project only.
SUPABASE_TARGET_URL=https://<TARGET_PROJECT_REF>.supabase.co
SUPABASE_TARGET_ANON_KEY=<target-anon-key>
SUPABASE_TARGET_SERVICE_ROLE_KEY=<target-service-role-key>
# Cloudflare official TEST secret: always passes. Replace for staging/prod.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RSVP_DEVICE_SECRET=change-me-to-a-random-32-byte-string
# Comma-separated e-mails bootstrapped as admins by migration seed (dev only).
ADMIN_EMAILS=
# Clerk (ADR 0005): server-side key used by the Worker to verify session tokens. NEVER in VITE_*.
CLERK_SECRET_KEY=<clerk-secret-key>
# Public; the Worker derives the expected token issuer (`iss`) from it (QA3-04). Alternatively
# set CLERK_ISSUER=https://<frontend-api-host>. Required outside local/test.
CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>
# CLERK_ISSUER=https://<instance>.clerk.accounts.dev
# Optional: Svix signing secret of the Clerk webhook endpoint (user.deleted -> erasure, QA3-02).
# Without it POST /api/v1/webhooks/clerk answers 404 (disabled).
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_<from-clerk-dashboard>
# Optional: Umami audience in the admin "Métricas" tab (D44). Use a VIEW-ONLY Umami user.
# UMAMI_API_URL=https://analytics.luqmarqs.dev
# UMAMI_WEBSITE_ID=<website-uuid>
# UMAMI_USERNAME=<read-only-user>
# UMAMI_PASSWORD=<read-only-password>
