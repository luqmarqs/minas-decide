# ---------------------------------------------------------------------------
# FRONTEND (Vite) — PUBLIC values only. Anything prefixed VITE_* ends up in the bundle.
# All of these refer to the NEW operational Supabase project (TARGET).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<TARGET_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<target-anon-or-publishable-key>
# Cloudflare Turnstile public sitekey. The value below is Cloudflare's official
# "always passes" TEST sitekey; replace with a real widget key for staging/prod.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Where electoral snapshot JSON lives (served as static assets)
VITE_SNAPSHOT_BASE=/data

# ---------------------------------------------------------------------------
# WORKER (Cloudflare) — put these in `.dev.vars` locally (gitignored) or set as
# `wrangler secret`. NEVER in wrangler.jsonc "vars" and NEVER with VITE_ prefix.
# See .dev.vars.example.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ETL (offline, local machine of an authorized operator ONLY).
# The legacy electoral database (SOURCE) is read through the authenticated
# Supabase CLI session linked in an ISOLATED workdir outside this repository.
# Do NOT put a SOURCE connection string here. Do NOT commit any value.
# ---------------------------------------------------------------------------
# ELECTORAL_SOURCE_WORKDIR=C:\Users\<you>\.minas-em-movimento\source-readonly
# A SELECT-only connection string may alternatively be exported in the shell
# (see docs/IMPORT_GUIDE.md). It must never be written to any file in this repo.
